<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="TransCalcAnchorPane" prefHeight="700.0" prefWidth="800.0" style="-fx-font-family: Segoe UI, Arial" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automationdescgen.TransformCalculatorController">
    <VBox layoutY="106.0" prefHeight="500.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER" prefHeight="51.0" prefWidth="600.0">
            <Label text="Transformation Calculator">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </HBox>
        <HBox alignment="CENTER" prefHeight="40.0" prefWidth="600.0" spacing="15.0">
            <Button fx:id="startPositionBtn" onAction="#addStartPosition" text="Add Start Position" />
         <Button fx:id="resetButton" mnemonicParsing="false" onAction="#clearUI" text="Reset" />
            <Button fx:id="endPositionBtn" onAction="#addEndPosition" text="Add End Position" />
         <padding>
            <Insets right="6.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
        </HBox>
        <HBox alignment="CENTER" prefHeight="180.0" prefWidth="600.0" spacing="20.0">
            <padding>
                <Insets bottom="15.0" />
            </padding>
            <TextArea fx:id="startTextArea" editable="false" focusTraversable="false" prefHeight="255.0" prefWidth="375.0" />
            <TextArea fx:id="endTextArea" editable="false" focusTraversable="false" prefHeight="255.0" prefWidth="375.0" />
        </HBox>
        <VBox fx:id="rotationChoicesVBox" alignment="CENTER" prefWidth="600.0" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
        <HBox alignment="CENTER" prefHeight="131.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" />
            </padding>
            <TextArea fx:id="messageTextArea" editable="false" focusTraversable="false" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
        </HBox>
        <HBox alignment="CENTER" prefHeight="49.0" prefWidth="600.0" spacing="15.0">
            <Button fx:id="confirmBtn" onAction="#confirmTransformation" text="Confirm" />
            <Button fx:id="helpButton" alignment="CENTER" contentDisplay="CENTER" layoutX="260.0" layoutY="32.0" mnemonicParsing="false" onAction="#loadHelpFile" prefWidth="100.0" text="Help" />
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#backToAddNew" text="Back" />
        </HBox>
    </VBox>
    <HBox alignment="CENTER_RIGHT" spacing="5.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
        <Button fx:id="decreaseFontButton" onAction="#decreaseFont" styleClass="font-scale-button" text="A-" />
        <Button fx:id="increaseFontButton" onAction="#increaseFont" styleClass="font-scale-button" text="A+" />
        <Button fx:id="themeToggleButton" onAction="#toggleTheme" styleClass="theme-toggle-button" text="🌙" />
    </HBox>
    <Label fx:id="versionLabel" text="v0.0.1" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="10.0" />
</AnchorPane>
